# GameZone Website Template — Environment Configuration Example
# -------------------------------------------------------------
# This commercial template is a standalone client-side SPA (Remix + Vite).
# All essential business data, pricing, menus, and contact information
# are easily configured in: app/config/siteConfig.ts
#
# If you deploy to custom domains or add optional third-party integrations,
# you can define them here.

# Canonical Production URL (used for sitemap, Open Graph, and meta tags)
VITE_SITE_URL=https://gamezone-arena.example.com

# Optional: Google Analytics / Tag Manager (Leave empty if not using)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Optional: Cloudflare Web Analytics Token (Leave empty if not using)
# VITE_CF_ANALYTICS_TOKEN=your_token_here
